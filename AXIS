<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AXIS — Integrated Code & Design</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
/* CUSTOM CURSOR */
*{ cursor: none !important; }
#cursor-dot{
  position:fixed;width:6px;height:6px;border-radius:50%;
  background:var(--cu2);z-index:9999;pointer-events:none;
  top:0;left:0;will-change:transform;
  mix-blend-mode:multiply;
}
#cursor-ring{
  position:fixed;width:36px;height:36px;border-radius:50%;
  border:1px solid rgba(184,98,26,0.55);z-index:9998;
  pointer-events:none;top:0;left:0;will-change:transform;
  transition:background 0.3s, border-color 0.3s;
}

/* GRAVITY LAYERS — magnetic tilt containers */
.grav-scene{ transform-style:preserve-3d; }
.svc, .pf{ transform-style:preserve-3d; }

/* MAG buttons */
.mag{ display:inline-block; }

*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --cu:#8a4510;--cu2:#b8621a;--cu3:#d4824a;--cu4:#e8a060;
  --bg:#f4f1ec;--bg2:#eeebe4;--bg3:#e8e4dc;--bg4:#ddd8ce;
  --dark:#0e0c0a;--dark2:#1a1612;--dark3:#2a2218;
  --white:#faf8f5;--muted:#7a7268;--muted2:#9a9288;
  --border:rgba(138,69,16,0.18);--border2:rgba(138,69,16,0.32);
  --shadow:rgba(80,40,10,0.12);
}

/* SMOOTH SCROLL: JS lerp inertia */
html{scroll-behavior:auto;} /* disable native smooth, JS handles it */
body{
  background:var(--bg);color:var(--dark);
  font-family:"DM Sans",sans-serif;font-weight:300;
  overflow-x:hidden;
  /* height + overflow-y set by JS setHeight() */
}

/* BG CANVAS — fixed behind everything */
#bg-canvas{
  position:fixed;inset:0;z-index:0;
  pointer-events:none;
  background:linear-gradient(160deg,#f9f6f1 0%,#ede8df 40%,#e4ddd2 100%);
}

/* SMOOTH WRAPPER: fixed viewport, content slides inside */
#smooth-wrapper{
  position:fixed;inset:0;z-index:1;overflow:hidden;
}
#smooth-content{
  will-change:transform;
  position:relative;z-index:2;
}

/* Ghost element gives the page its real scroll height */
#scroll-ghost{
  position:fixed;top:0;left:0;width:1px;visibility:hidden;
}

/* NAV */
nav{
  position:fixed;top:0;left:0;right:0;z-index:500;
  display:flex;align-items:center;justify-content:space-between;
  padding:1rem 4rem;
  background:rgba(249,246,241,0.82);
  backdrop-filter:blur(24px);
  border-bottom:0.5px solid var(--border);
  transition:padding 0.4s cubic-bezier(0.16,1,0.3,1),box-shadow 0.4s;
}
nav.scrolled{padding:0.65rem 4rem;box-shadow:0 4px 40px rgba(80,40,10,0.08);}
.nav-logo{font-family:"Cormorant Garamond",serif;font-size:1.5rem;font-weight:600;letter-spacing:0.32em;color:var(--dark);text-transform:uppercase;text-decoration:none;}
.nav-logo em{color:var(--cu2);font-style:normal;}
.nav-links{display:flex;gap:2.5rem;list-style:none;}
.nav-links a{font-size:0.66rem;letter-spacing:0.2em;color:var(--muted);text-decoration:none;text-transform:uppercase;transition:color 0.3s;}
.nav-links a:hover{color:var(--cu2);}
.nav-btn{font-size:0.66rem;letter-spacing:0.18em;color:var(--white);background:var(--cu2);border:none;padding:0.65rem 1.6rem;text-decoration:none;text-transform:uppercase;cursor:pointer;box-shadow:0 2px 0 var(--cu),0 4px 12px rgba(138,69,16,0.25);transition:all 0.12s ease;position:relative;top:0;}
.nav-btn:hover{top:2px;box-shadow:0 1px 0 var(--cu),0 2px 8px rgba(138,69,16,0.2);}
.nav-btn:active{top:3px;box-shadow:0 1px 4px rgba(138,69,16,0.15);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;}
.hamburger span{display:block;width:22px;height:1.5px;background:var(--dark);transition:all 0.3s;}
.mobile-menu{display:none;position:fixed;inset:0;z-index:490;background:rgba(249,246,241,0.97);backdrop-filter:blur(24px);flex-direction:column;align-items:center;justify-content:center;gap:2.5rem;}
.mobile-menu.open{display:flex;}
.mobile-menu a{font-size:1.4rem;letter-spacing:0.3em;color:var(--dark);text-decoration:none;text-transform:uppercase;font-family:"Cormorant Garamond",serif;transition:color 0.3s;}
.mobile-menu a:hover{color:var(--cu2);}

/* HERO */
#hero{
  min-height:100vh;display:grid;grid-template-columns:1fr 1fr;
  align-items:center;padding:0 4rem;padding-top:80px;
  overflow:hidden;gap:3rem;
}
.hero-left{position:relative;z-index:4;}
.hero-eyebrow{font-size:0.62rem;letter-spacing:0.38em;color:var(--cu2);text-transform:uppercase;margin-bottom:2rem;display:flex;align-items:center;gap:1rem;}
.hero-eyebrow::before{content:"";display:block;width:28px;height:0.5px;background:var(--cu2);}
.hero-title{font-family:"Cormorant Garamond",serif;font-size:clamp(3.5rem,6vw,6rem);font-weight:300;line-height:0.92;letter-spacing:0.06em;margin-bottom:2rem;}
.hero-title em{font-style:normal;color:var(--cu2);}
.hero-desc{font-size:0.9rem;line-height:1.95;color:var(--muted);max-width:420px;margin-bottom:3rem;}
.btns{display:flex;gap:1.2rem;flex-wrap:wrap;}
.btn-primary{font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;padding:0.95rem 2.2rem;cursor:pointer;border:none;font-family:"DM Sans",sans-serif;color:var(--white);background:var(--cu2);position:relative;top:0;transition:all 0.12s ease;text-decoration:none;display:inline-block;box-shadow:0 2px 0 var(--cu),0 4px 16px rgba(138,69,16,0.22);}
.btn-primary:hover{top:2px;box-shadow:0 1px 0 var(--cu),0 2px 10px rgba(138,69,16,0.18);}
.btn-ghost{font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;padding:0.95rem 2.2rem;cursor:pointer;font-family:"DM Sans",sans-serif;color:var(--cu2);background:transparent;border:0.5px solid var(--border2);position:relative;top:0;transition:all 0.12s ease;text-decoration:none;display:inline-block;box-shadow:0 2px 0 rgba(138,69,16,0.08);}
.btn-ghost:hover{top:2px;background:rgba(184,98,26,0.05);}

/* HERO 3D CUBES */
.hero-right{position:relative;z-index:4;display:flex;align-items:center;justify-content:center;}
.hero-scene{position:relative;width:460px;height:460px;perspective:1200px;perspective-origin:50% 50%;}
.scene-3d{position:absolute;inset:0;transform-style:preserve-3d;}
.cube-group{width:100%;height:100%;transform-style:preserve-3d;will-change:transform;}
.cube{position:absolute;transform-style:preserve-3d;}
.face{position:absolute;border:0.5px solid rgba(138,69,16,0.2);width:100%;height:100%;}
.f{background:linear-gradient(135deg,rgba(235,228,216,0.96),rgba(215,206,192,0.9));}
.ftop{background:linear-gradient(135deg,rgba(248,244,236,1),rgba(232,224,210,0.95));}
.fbot{background:rgba(185,172,155,0.55);}
.c1{width:100px;height:100px;left:180px;top:180px;}
.c1 .front{transform:translateZ(50px);}.c1 .back{transform:rotateY(180deg) translateZ(50px);}
.c1 .right{transform:rotateY(90deg) translateZ(50px);}.c1 .left{transform:rotateY(-90deg) translateZ(50px);}
.c1 .ctop{transform:rotateX(90deg) translateZ(50px);}.c1 .cbot{transform:rotateX(-90deg) translateZ(50px);}
.c2{width:66px;height:66px;left:90px;top:120px;}
.c2 .front{transform:translateZ(33px);}.c2 .back{transform:rotateY(180deg) translateZ(33px);}
.c2 .right{transform:rotateY(90deg) translateZ(33px);}.c2 .left{transform:rotateY(-90deg) translateZ(33px);}
.c2 .ctop{transform:rotateX(90deg) translateZ(33px);}.c2 .cbot{transform:rotateX(-90deg) translateZ(33px);}
.c3{width:52px;height:52px;left:310px;top:74px;}
.c3 .front{transform:translateZ(26px);}.c3 .back{transform:rotateY(180deg) translateZ(26px);}
.c3 .right{transform:rotateY(90deg) translateZ(26px);}.c3 .left{transform:rotateY(-90deg) translateZ(26px);}
.c3 .ctop{transform:rotateX(90deg) translateZ(26px);}.c3 .cbot{transform:rotateX(-90deg) translateZ(26px);}
.c4{width:44px;height:44px;left:296px;top:330px;}
.c4 .front{transform:translateZ(22px);}.c4 .back{transform:rotateY(180deg) translateZ(22px);}
.c4 .right{transform:rotateY(90deg) translateZ(22px);}.c4 .left{transform:rotateY(-90deg) translateZ(22px);}
.c4 .ctop{transform:rotateX(90deg) translateZ(22px);}.c4 .cbot{transform:rotateX(-90deg) translateZ(22px);}
.c5{width:36px;height:36px;left:120px;top:304px;}
.c5 .front{transform:translateZ(18px);}.c5 .back{transform:rotateY(180deg) translateZ(18px);}
.c5 .right{transform:rotateY(90deg) translateZ(18px);}.c5 .left{transform:rotateY(-90deg) translateZ(18px);}
.c5 .ctop{transform:rotateX(90deg) translateZ(18px);}.c5 .cbot{transform:rotateX(-90deg) translateZ(18px);}
.c6{width:28px;height:28px;left:370px;top:238px;}
.c6 .front{transform:translateZ(14px);}.c6 .back{transform:rotateY(180deg) translateZ(14px);}
.c6 .right{transform:rotateY(90deg) translateZ(14px);}.c6 .left{transform:rotateY(-90deg) translateZ(14px);}
.c6 .ctop{transform:rotateX(90deg) translateZ(14px);}.c6 .cbot{transform:rotateX(-90deg) translateZ(14px);}
.glow-ring{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:310px;height:310px;border-radius:50%;border:0.5px solid rgba(184,98,26,0.28);animation:ringPulse 4s ease-in-out infinite;}
.glow-ring2{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:390px;height:390px;border-radius:50%;border:0.5px solid rgba(184,98,26,0.1);animation:ringPulse 4s ease-in-out 2s infinite;}
@keyframes ringPulse{0%,100%{opacity:0.4;}50%{opacity:1;}}

/* MARQUEE */
.marquee-strip{background:var(--cu2);padding:0.8rem 0;overflow:hidden;white-space:nowrap;}
.marquee-inner{display:inline-block;animation:marquee 22s linear infinite;}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}
.mi{display:inline-block;font-size:0.58rem;letter-spacing:0.28em;color:rgba(250,248,245,0.85);text-transform:uppercase;margin:0 2rem;}
.mi span{color:rgba(255,255,255,0.45);}

/* SECTIONS */
section{padding:8rem 4rem;}
.container{max-width:1180px;margin:0 auto;}
.section-label{font-size:0.6rem;letter-spacing:0.38em;color:var(--cu2);text-transform:uppercase;margin-bottom:1.2rem;display:flex;align-items:center;gap:0.8rem;}
.section-label::before{content:"";display:block;width:22px;height:0.5px;background:var(--cu2);}
.section-title{font-family:"Cormorant Garamond",serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:300;line-height:1.05;margin-bottom:1.5rem;}
.section-title em{color:var(--cu2);font-style:normal;}

/* ABOUT */
#about{background:rgba(250,248,245,0.92);}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center;}
.about-frame{position:relative;padding:2.5rem;background:rgba(238,235,228,0.9);border:0.5px solid var(--border);box-shadow:0 12px 50px var(--shadow);}
.about-frame::before{content:"";position:absolute;top:-1px;left:40px;right:40px;height:1px;background:linear-gradient(90deg,transparent,var(--cu2),transparent);}
.about-frame::after{content:"";position:absolute;bottom:-1px;left:40px;right:40px;height:1px;background:linear-gradient(90deg,transparent,var(--cu2),transparent);}
.corner{position:absolute;width:14px;height:14px;border-color:var(--cu);border-style:solid;border-width:0;}
.corner.tl{top:-1px;left:-1px;border-top-width:1.5px;border-left-width:1.5px;}
.corner.tr{top:-1px;right:-1px;border-top-width:1.5px;border-right-width:1.5px;}
.corner.bl{bottom:-1px;left:-1px;border-bottom-width:1.5px;border-left-width:1.5px;}
.corner.br{bottom:-1px;right:-1px;border-bottom-width:1.5px;border-right-width:1.5px;}
.about-frame img{width:100%;height:auto;display:block;}
.about-text p{font-size:0.9rem;line-height:1.95;color:var(--muted);margin-bottom:1.3rem;}
.about-text strong{color:var(--dark);font-weight:400;}
.stats-row{display:grid;grid-template-columns:repeat(3,1fr);margin-top:2.8rem;border:0.5px solid var(--border);}
.stat-box{padding:1.5rem;border-right:0.5px solid var(--border);text-align:center;background:rgba(244,241,236,0.8);}
.stat-box:last-child{border-right:none;}
.stat-num{font-family:"Cormorant Garamond",serif;font-size:2.6rem;font-weight:300;color:var(--cu2);display:block;line-height:1;margin-bottom:0.3rem;}
.stat-lbl{font-size:0.58rem;letter-spacing:0.18em;color:var(--muted);text-transform:uppercase;}

/* SERVICES */
#services{background:rgba(244,241,236,0.88);}
.services-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:4rem;flex-wrap:wrap;gap:1rem;}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);border:0.5px solid var(--border);}
.svc{padding:2.8rem 2.2rem;border-right:0.5px solid var(--border);border-bottom:0.5px solid var(--border);position:relative;overflow:hidden;transition:background 0.35s,transform 0.4s cubic-bezier(0.16,1,0.3,1),box-shadow 0.4s;cursor:default;background:rgba(250,248,245,0.85);}
.svc:nth-child(3n){border-right:none;}
.svc:nth-child(4),.svc:nth-child(5),.svc:nth-child(6){border-bottom:none;}
.svc::after{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--cu2),transparent);opacity:0;transition:opacity 0.4s;}
.svc:hover{background:rgba(238,235,228,0.9);transform:translateY(-4px);box-shadow:0 16px 50px var(--shadow);}
.svc:hover::after{opacity:1;}
.svc-num{font-family:"Cormorant Garamond",serif;font-size:3rem;font-weight:300;color:rgba(184,98,26,0.1);line-height:1;margin-bottom:1.5rem;}
.svc-name{font-size:0.72rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--dark);margin-bottom:0.9rem;font-weight:500;}
.svc-desc{font-size:0.82rem;line-height:1.8;color:var(--muted);}
.svc-tags{display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:1.8rem;}
.tag{font-size:0.58rem;letter-spacing:0.12em;color:var(--cu2);border:0.5px solid var(--border);padding:0.25rem 0.7rem;text-transform:uppercase;background:rgba(184,98,26,0.04);}

/* PORTFOLIO */
#portfolio{background:rgba(238,235,228,0.88);}
.portfolio-top{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:4rem;flex-wrap:wrap;gap:1rem;}
.portfolio-grid{display:grid;grid-template-columns:1fr 1fr;border:0.5px solid var(--border);}
.pf{padding:3rem;border-right:0.5px solid var(--border);border-bottom:0.5px solid var(--border);min-height:220px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;cursor:pointer;background:rgba(250,248,245,0.85);transition:background 0.35s,transform 0.4s cubic-bezier(0.16,1,0.3,1),box-shadow 0.4s;}
.pf:nth-child(2n){border-right:none;}
.pf:nth-child(3),.pf:nth-child(4){border-bottom:none;}
.pf:hover{background:rgba(238,235,228,0.95);transform:translateY(-3px);box-shadow:0 10px 36px var(--shadow);}
.pf-num{position:absolute;top:1.8rem;right:2rem;font-family:"Cormorant Garamond",serif;font-size:5.5rem;font-weight:300;color:rgba(184,98,26,0.06);line-height:1;}
.pf-arrow{position:absolute;top:2rem;left:2.5rem;font-size:1.1rem;color:var(--cu2);opacity:0;transform:translate(-6px,6px);transition:all 0.35s cubic-bezier(0.16,1,0.3,1);}
.pf:hover .pf-arrow{opacity:1;transform:translate(0,0);}
.pf-type{font-size:0.6rem;letter-spacing:0.24em;color:var(--cu2);text-transform:uppercase;margin-bottom:0.6rem;}
.pf-name{font-family:"Cormorant Garamond",serif;font-size:1.75rem;font-weight:300;line-height:1.2;margin-bottom:0.5rem;color:var(--dark);}
.pf-tech{font-size:0.72rem;color:var(--muted);letter-spacing:0.06em;}

/* CONTACT */
#contact{background:rgba(250,248,245,0.92);}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:start;}
.contact-text{font-size:0.88rem;line-height:1.9;color:var(--muted);margin-bottom:2rem;}
.contact-detail{display:flex;flex-direction:column;gap:1.1rem;margin-top:2.5rem;padding-top:2.5rem;border-top:0.5px solid var(--border);}
.c-row{display:flex;align-items:center;gap:1rem;}
.c-dot{width:5px;height:5px;border-radius:50%;background:var(--cu2);flex-shrink:0;}
.c-val{font-size:0.8rem;color:var(--dark);letter-spacing:0.04em;text-decoration:none;transition:color 0.3s;}
.c-val:hover{color:var(--cu2);}
.c-lbl{font-size:0.58rem;letter-spacing:0.18em;color:var(--muted);text-transform:uppercase;margin-left:auto;}
.form{display:flex;flex-direction:column;gap:1.1rem;}
.form-row2{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;}
.fg{display:flex;flex-direction:column;gap:0.4rem;}
.fl{font-size:0.58rem;letter-spacing:0.22em;color:var(--cu2);text-transform:uppercase;}
.fi,.ft{background:rgba(244,241,236,0.9);border:0.5px solid var(--border);color:var(--dark);font-family:"DM Sans",sans-serif;font-size:0.85rem;font-weight:300;padding:0.85rem 1rem;outline:none;transition:border-color 0.3s,box-shadow 0.3s;width:100%;}
.fi:focus,.ft:focus{border-color:var(--cu2);box-shadow:0 0 0 3px rgba(184,98,26,0.07);}
.fi::placeholder,.ft::placeholder{color:var(--muted2);}
.ft{min-height:120px;resize:none;}
.fsub{align-self:flex-start;margin-top:0.5rem;font-size:0.68rem;letter-spacing:0.2em;color:var(--white);background:var(--cu2);border:none;padding:0.95rem 2.4rem;text-transform:uppercase;cursor:pointer;font-family:"DM Sans",sans-serif;position:relative;top:0;transition:all 0.1s ease;box-shadow:0 2px 0 var(--cu),0 4px 14px rgba(138,69,16,0.2);}
.fsub:hover{top:2px;box-shadow:0 1px 0 var(--cu),0 2px 8px rgba(138,69,16,0.15);}
.fsub:active{top:3px;box-shadow:none;}
#success{display:none;font-size:0.78rem;color:var(--cu2);letter-spacing:0.1em;margin-top:0.5rem;}

/* FOOTER */
footer{background:var(--dark);padding:2.5rem 4rem;border-top:0.5px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;}
.footer-logo{font-family:"Cormorant Garamond",serif;font-size:1.15rem;font-weight:600;letter-spacing:0.3em;color:var(--white);}
.footer-logo em{color:var(--cu3);font-style:normal;}
.footer-sub{font-size:0.58rem;letter-spacing:0.22em;color:rgba(255,255,255,0.3);text-transform:uppercase;}
.footer-copy{font-size:0.62rem;letter-spacing:0.08em;color:rgba(255,255,255,0.3);}

/* ═══════════════════════════════════════════
   REVEAL ANIMATIONS — rich multi-variant system
   ═══════════════════════════════════════════ */

/* Base transition shared by all reveal classes */
.reveal,.reveal-left,.reveal-right,.reveal-up,.reveal-scale,.reveal-flip,.reveal-blur,.reveal-split,.reveal-drop,.reveal-spin{
  will-change:opacity,transform,filter;
}

/* ── .reveal — float up with 3D perspective tilt ── */
.reveal{
  opacity:0;
  transform:perspective(1200px) translateY(90px) rotateX(22deg);
  transition:
    opacity 1.1s cubic-bezier(0.16,1,0.3,1),
    transform 1.1s cubic-bezier(0.16,1,0.3,1);
}
.reveal.on{
  opacity:1;
  transform:perspective(1200px) translateY(0) rotateX(0deg);
}

/* ── .reveal-left — slide in from left with Y-axis twist ── */
.reveal-left{
  opacity:0;
  transform:perspective(1200px) translateX(-140px) rotateY(28deg) skewY(2deg);
  transition:
    opacity 1.15s cubic-bezier(0.16,1,0.3,1),
    transform 1.2s cubic-bezier(0.16,1,0.3,1);
}
.reveal-left.on{
  opacity:1;
  transform:perspective(1200px) translateX(0) rotateY(0deg) skewY(0deg);
}

/* ── .reveal-right — slide in from right with Y-axis twist ── */
.reveal-right{
  opacity:0;
  transform:perspective(1200px) translateX(140px) rotateY(-28deg) skewY(-2deg);
  transition:
    opacity 1.15s cubic-bezier(0.16,1,0.3,1),
    transform 1.2s cubic-bezier(0.16,1,0.3,1);
}
.reveal-right.on{
  opacity:1;
  transform:perspective(1200px) translateX(0) rotateY(0deg) skewY(0deg);
}

/* ── .reveal-blur — fade in with blur clearing + lift ── */
.reveal-blur{
  opacity:0;
  filter:blur(18px) saturate(0.4);
  transform:translateY(50px) scale(0.93);
  transition:
    opacity 1.3s cubic-bezier(0.16,1,0.3,1),
