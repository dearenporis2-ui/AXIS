// 7. CURSOR GRAVITY / WEIGHT PARALLAX
// ═══════════════════════════════════════════

// --- Custom cursor ---
var cursorDot   = document.getElementById('cursor-dot');
var cursorRing  = document.getElementById('cursor-ring');
var mx = window.innerWidth/2, my = window.innerHeight/2;
var rx = mx, ry = my;
var cursorScale = 1;

document.addEventListener('mousemove', function(e){ mx = e.clientX; my = e.clientY; });

(function cursorLoop(){
  rx += (mx - rx) * 0.14;
  ry += (my - ry) * 0.14;
  cursorDot.style.transform  = 'translate('+(mx-3)+'px,'+(my-3)+'px)';
  cursorRing.style.transform = 'translate('+(rx-18)+'px,'+(ry-18)+'px) scale('+cursorScale+')';
  requestAnimationFrame(cursorLoop);
})();

document.querySelectorAll('a,button,.svc,.pf,.btn-primary,.btn-ghost,.nav-btn,.fsub').forEach(function(el){
  el.addEventListener('mouseenter', function(){ cursorScale = 2.2; cursorRing.style.background='rgba(184,98,26,0.06)'; cursorRing.style.borderColor='rgba(184,98,26,0.7)'; });
  el.addEventListener('mouseleave', function(){ cursorScale = 1; cursorRing.style.background='transparent'; cursorRing.style.borderColor='rgba(184,98,26,0.55)'; });
});

// --- Per-section gravity parallax ---
// Each section has multiple "layers" that shift based on cursor distance from center
var gravLayers = [];

// Collect all gravity-enabled elements
document.querySelectorAll('[data-grav]').forEach(function(el){
  var depth = parseFloat(el.getAttribute('data-grav')) || 1;
  gravLayers.push({ el: el, depth: depth, cx: 0, cy: 0 });
});

var gmx = 0, gmy = 0; // normalised -1..1 cursor per section
document.addEventListener('mousemove', function(e){
  gmx = (e.clientX / window.innerWidth  - 0.5) * 2;
  gmy = (e.clientY / window.innerHeight - 0.5) * 2;
});

// Smooth cursor grav values
var sgx = 0, sgy = 0;
(function gravLoop(){
  sgx += (gmx - sgx) * 0.07;
  sgy += (gmy - sgy) * 0.07;

  gravLayers.forEach(function(item){
    // Only animate if element is in or near viewport
    var rect = item.el.getBoundingClientRect();
    var vh = window.innerHeight;
    if(rect.bottom < -vh*0.3 || rect.top > vh*1.3) return;

    var tx = sgx * item.depth * 22;
    var ty = sgy * item.depth * 14;

    item.cx += (tx - item.cx) * 0.09;
    item.cy += (ty - item.cy) * 0.09;

    // Preserve any existing transform and add gravity offset
    var base = item.el._baseTransform || '';
    item.el.style.transform = base + ' translate('+ item.cx +'px,'+ item.cy +'px)';
  });

  requestAnimationFrame(gravLoop);
})();

// --- Magnetic buttons ---
document.querySelectorAll('.mag').forEach(function(btn){
  btn.addEventListener('mousemove', function(e){
    var r   = btn.getBoundingClientRect();
    var bx  = r.left + r.width  * 0.5;
    var by  = r.top  + r.height * 0.5;
    var dx  = (e.clientX - bx) * 0.38;
    var dy  = (e.clientY - by) * 0.38;
    btn.style.transform = 'translate('+ dx +'px,'+ dy +'px) translateY(0)';
    btn.style.transition = 'transform 0.12s ease';
  });
  btn.addEventListener('mouseleave', function(){
    btn.style.transform = '';
    btn.style.transition = 'transform 0.55s cubic-bezier(0.16,1,0.3,1)';
  });
});

// --- Section card tilt on hover ---
document.querySelectorAll('.svc, .pf').forEach(function(card){
  card.addEventListener('mousemove', function(e){
    var r  = card.getBoundingClientRect();
    var nx = (e.clientX - r.left) / r.width  - 0.5;
    var ny = (e.clientY - r.top)  / r.height - 0.5;
    card.style.transform = 'translateY(-4px) rotateX('+ (-ny*7) +'deg) rotateY('+ (nx*7) +'deg)';
    card.style.transition = 'transform 0.1s ease';
  });
  card.addEventListener('mouseleave', function(){
    card.style.transform = '';
    card.style.transition = 'transform 0.55s cubic-bezier(0.16,1,0.3,1)';
  });
});

