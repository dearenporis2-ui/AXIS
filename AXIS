  }
}

// SERVICES: 3D grid lattice
var lattice=[];
var LX=7,LY=5;
for(var ix=0;ix<LX;ix++) for(var iy=0;iy<LY;iy++){
  lattice.push({
    bx:(ix-(LX-1)/2)*110, by:(iy-(LY-1)/2)*90,
    phase:Math.random()*Math.PI*2, amp:20+Math.random()*30,
    copper:(ix+iy)%5===0
  });
}

function drawServices(alpha,cx,cy,vel){
  var fov=440;
  var pts3d=lattice.map(function(n){
    var bz=480+Math.sin(t3*0.9+n.phase)*n.amp + vel*4;
    return p3(n.bx,n.by,bz,fov,cx,cy);
  });
  for(var iy=0;iy<LY;iy++){
    for(var ix=0;ix<LX-1;ix++){
      var a=pts3d[ix+iy*LX], b=pts3d[ix+1+iy*LX];
      if(!a||!b) continue;
      ctx.globalAlpha=0.18*alpha; ctx.strokeStyle=MID; ctx.lineWidth=0.7;
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }
  }
  for(var ix=0;ix<LX;ix++){
    for(var iy=0;iy<LY-1;iy++){
      var a=pts3d[ix+iy*LX], b=pts3d[ix+(iy+1)*LX];
      if(!a||!b) continue;
      ctx.globalAlpha=0.18*alpha; ctx.strokeStyle=MID; ctx.lineWidth=0.7;
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }
  }
  for(var i=0;i<pts3d.length;i++){
    var pp=pts3d[i], nd=lattice[i]; if(!pp) continue;
    ctx.globalAlpha=(nd.copper?0.7:0.35)*alpha;
    ctx.beginPath(); ctx.arc(pp.x,pp.y,Math.max(0.5,(nd.copper?2.5:1.5)*pp.s*3),0,Math.PI*2);
    ctx.fillStyle=nd.copper?CU:MID; ctx.fill();
  }
}

// PORTFOLIO: wave mesh
var WAVE_X=14, WAVE_Y=9;
var wavePts=[];
for(var ix=0;ix<WAVE_X;ix++) for(var iy=0;iy<WAVE_Y;iy++){
  wavePts.push({
    bx:(ix-(WAVE_X-1)/2)*75, by:(iy-(WAVE_Y-1)/2)*65,
    px:Math.random()*Math.PI*2, py:Math.random()*Math.PI*2
  });
}

function drawPortfolio(alpha,cx,cy,vel){
  var fov=400;
  var pts3d=wavePts.map(function(n){
    var wave=Math.sin(t3*1.1+n.px)*30+Math.cos(t3*0.7+n.py)*20+vel*5;
    return p3(n.bx, n.by+wave, 500, fov, cx, cy);
  });
  for(var iy=0;iy<WAVE_Y;iy++){
    for(var ix=0;ix<WAVE_X-1;ix++){
      var a=pts3d[ix+iy*WAVE_X], b=pts3d[ix+1+iy*WAVE_X];
      if(!a||!b) continue;
      ctx.globalAlpha=0.22*alpha; ctx.strokeStyle=CU; ctx.lineWidth=0.8;
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }
  }
  for(var ix=0;ix<WAVE_X;ix++){
    for(var iy=0;iy<WAVE_Y-1;iy++){
      var a=pts3d[ix+iy*WAVE_X], b=pts3d[ix+(iy+1)*WAVE_X];
      if(!a||!b) continue;
      ctx.globalAlpha=0.14*alpha; ctx.strokeStyle=MID; ctx.lineWidth=0.6;
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }
  }
  for(var i=0;i<pts3d.length;i++){
    var pp=pts3d[i]; if(!pp) continue;
    ctx.globalAlpha=0.4*alpha;
    ctx.beginPath(); ctx.arc(pp.x,pp.y,Math.max(0.4,1.2*pp.s*3),0,Math.PI*2);
    ctx.fillStyle=i%7===0?CU:MID; ctx.fill();
  }
}

// CONTACT: concentric rings
function drawContact(alpha,cx,cy,vel){
  var count=7;
  for(var i=0;i<count;i++){
    var r=60+i*55+Math.sin(t3*0.8+i)*15 + Math.abs(vel)*3;
    var a=(0.35-i*0.04)*alpha;
    if(a<=0) continue;
    ctx.globalAlpha=a;
    ctx.strokeStyle=i%3===0?CU:MID;
    ctx.lineWidth=i===0?1.5:0.6;
    ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2); ctx.stroke();
    for(var d=0;d<8;d++){
      var da=d/8*Math.PI*2+t3*0.3*(i%2===0?1:-1);
      var dx=cx+Math.cos(da)*r, dy=cy+Math.sin(da)*r;
      ctx.globalAlpha=0.5*a;
      ctx.beginPath(); ctx.arc(dx,dy,d%3===0?2:1,0,Math.PI*2);
      ctx.fillStyle=d%3===0?CU:MID; ctx.fill();
    }
  }
}

// MAIN DRAW LOOP
var sections=['hero','about','services','portfolio','contact'];
var sectionEls=sections.map(function(id){ return document.getElementById(id); });
var prevScroll3=0, vel3=0;

function getSectionWeights(){
  var mid=currentY+H*0.5;
  var weights=[];
  for(var i=0;i<sectionEls.length;i++){
    var el=sectionEls[i]; if(!el){weights.push(0);continue;}
    var elTop=el.offsetTop, elH=el.offsetHeight;
    var dist=Math.abs(mid-(elTop+elH*0.5));
    var w=Math.max(0,1-dist/(H*0.85));
    weights.push(w);
  }
  var sum=weights.reduce(function(a,b){return a+b;},0)||1;
  return weights.map(function(w){return w/sum;});
}

function drawBg(){
  ctx.clearRect(0,0,W,H);
  t3+=0.012;
  var sv=currentY-prevScroll3; prevScroll3=currentY;
  vel3+=(sv-vel3)*0.15;

  var cx=W*0.5, cy=H*0.48;
  var weights=getSectionWeights();
  ctx.globalAlpha=1;

  if(weights[0]>0.01) drawHero(weights[0],cx,cy,vel3);
  if(weights[1]>0.01) drawAbout(weights[1],cx,cy,vel3);
  if(weights[2]>0.01) drawServices(weights[2],cx,cy,vel3);
  if(weights[3]>0.01) drawPortfolio(weights[3],cx,cy,vel3);
  if(weights[4]>0.01) drawContact(weights[4],cx,cy,vel3);

  ctx.globalAlpha=1;
  requestAnimationFrame(drawBg);
}
requestAnimationFrame(drawBg);


// ═══════════════════════════════════════════
// 3. PARALLAX — multi-layer depth system
// ═══════════════════════════════════════════
var cubeGroup = document.getElementById('cubeGroup');
var cubeTilt = 12;
var targetTilt = 12;
var prevSmooth = 0;
var nav2 = document.getElementById('mainNav');

// Cache section elements for per-section parallax
var heroSection    = document.getElementById('hero');
var aboutSection   = document.getElementById('about');
var servSection    = document.getElementById('services');
var portSection    = document.getElementById('portfolio');
var contactSection = document.getElementById('contact');

function getSectionParallax(section, sy) {
  if (!section) return 0;
  var rect = section.getBoundingClientRect();
  var sectionCenter = rect.top + rect.height * 0.5;
  return sectionCenter / window.innerHeight;
}

function updateParallax(sy){
  var sv2 = sy - prevSmooth;
  prevSmooth = sy;

  // ── Cube tilt from scroll velocity ──────────────────────────
  targetTilt = 12 + sv2 * 0.7;
  cubeTilt += (targetTilt - cubeTilt) * 0.1;
  var cubeRotY = (sy / 4) % 360;

  if(cubeGroup){
    cubeGroup.style.transform =
      'rotateX(' + cubeTilt + 'deg) rotateY(' + cubeRotY + 'deg)';
  }

  // ── Hero section — deep multi-layer parallax ────────────────
  var vh = window.innerHeight;
  if(heroSection){
    var heroTop = heroSection.getBoundingClientRect().top;
    var heroRatio = heroTop / vh;

    var heroTitle = heroSection.querySelector('.hero-title');
    var heroEye   = heroSection.querySelector('.hero-eyebrow');
    var heroDesc  = heroSection.querySelector('.hero-desc');
    var heroBtns  = heroSection.querySelector('.btns');
    var heroRight = heroSection.querySelector('.hero-right');

    // Deeper parallax with different speeds per layer
    if(heroTitle) heroTitle.style.transform = 'translateY(' + (heroRatio * -55) + 'px)';
    if(heroEye)   heroEye.style.transform   = 'translateY(' + (heroRatio * -35) + 'px)';
    if(heroDesc)  heroDesc.style.transform  = 'translateY(' + (heroRatio * -22) + 'px)';
    if(heroBtns)  heroBtns.style.transform  = 'translateY(' + (heroRatio * -14) + 'px)';
    // Hero right (cubes) move at a different rate creating depth
    if(heroRight) heroRight.style.transform = 'translateY(' + (heroRatio * -70) + 'px)';
  }

  // ── About section parallax ────────────────────────────────────
  if(aboutSection){
    var aboutTop = aboutSection.getBoundingClientRect().top;
    var aboutRatio = aboutTop / vh;
    var aboutFrame = aboutSection.querySelector('.about-frame');
    var aboutText  = aboutSection.querySelector('.about-text');
    if(aboutFrame) aboutFrame.style.transform = 'translateY(' + (aboutRatio * -28) + 'px)';
    if(aboutText)  aboutText.style.transform  = 'translateY(' + (aboutRatio * -16) + 'px)';
  }

  // ── Services section parallax ─────────────────────────────────
  if(servSection){
    var servTop = servSection.getBoundingClientRect().top;
    var servRatio = servTop / vh;
    var servHeader = servSection.querySelector('.services-header');
    if(servHeader) servHeader.style.transform = 'translateY(' + (servRatio * -20) + 'px)';
  }

  // ── Portfolio section parallax ────────────────────────────────
  if(portSection){
    var portTop = portSection.getBoundingClientRect().top;
    var portRatio = portTop / vh;
    var portTop2 = portSection.querySelector('.portfolio-top');
    if(portTop2) portTop2.style.transform = 'translateY(' + (portRatio * -20) + 'px)';
    var pfCards = portSection.querySelectorAll('.pf');
    pfCards.forEach(function(card, i){
      var rowDepth = Math.floor(i / 2) * 6;
      card.style.transform = 'translateY(' + (portRatio * -(10 + rowDepth)) + 'px)';
    });
  }

  // ── Contact section parallax ──────────────────────────────────
  if(contactSection){
    var conTop = contactSection.getBoundingClientRect().top;
    var conRatio = conTop / vh;
    // Only apply to the inner content containers, not to elements mid-animation
    var conLeft  = contactSection.querySelector('.reveal-left');
    var conRight = contactSection.querySelector('.reveal-right');
    // Only add parallax offset once they have the .on class (animation complete)
    if(conLeft && conLeft.classList.contains('on')){
      conLeft.style.transform  = 'translateY(' + (conRatio * -18) + 'px)';
    }
    if(conRight && conRight.classList.contains('on')){
      conRight.style.transform = 'translateY(' + (conRatio * -12) + 'px)';
    }
  }

  // NAV
  nav2.classList.toggle('scrolled', sy > 60);
}


