// ═══════════════════════════════════════════
// 5. SCROLL REVEAL — multi-variant IntersectionObserver
// ═══════════════════════════════════════════

function assignReveal(el, cls){
  // Strip any existing reveal class first
  ['reveal','reveal-left','reveal-right','reveal-blur','reveal-scale','reveal-flip','reveal-drop','reveal-spin'].forEach(function(c){ el.classList.remove(c); });
  el.classList.add(cls);
}

// ── ABOUT section ──
var aboutFrame = document.querySelector('.about-frame');
if(aboutFrame) assignReveal(aboutFrame, 'reveal-blur');

var aboutText = document.querySelector('.about-text');
if(aboutText) assignReveal(aboutText, 'reveal-right');

document.querySelectorAll('.stat-box').forEach(function(el, i){
  assignReveal(el, 'reveal-scale');
  el.style.transitionDelay = (i * 0.12) + 's';
});

// ── Section labels & titles — drop in from above ──
document.querySelectorAll('.section-label').forEach(function(el){
  assignReveal(el, 'reveal-drop');
});
document.querySelectorAll('.section-title').forEach(function(el){
  // skip hero title (already has its own)
  if(!el.closest('#hero')) assignReveal(el, 'reveal-drop');
});

// ── SERVICES — alternating left/right/flip with stagger ──
document.querySelectorAll('.svc').forEach(function(el, i){
  if(i % 3 === 0)      assignReveal(el, 'reveal-flip');
  else if(i % 3 === 1) assignReveal(el, 'reveal-left');
  else                 assignReveal(el, 'reveal-right');
  el.style.transitionDelay = (i * 0.1) + 's';
});

// ── PORTFOLIO cards — alternating spin / scale ──
document.querySelectorAll('.pf').forEach(function(el, i){
  assignReveal(el, i % 2 === 0 ? 'reveal-spin' : 'reveal-scale');
  el.style.transitionDelay = (i * 0.13) + 's';
});

// ── Services header desc text ──
document.querySelectorAll('.services-header p, .services-header a').forEach(function(el){
  assignReveal(el, 'reveal-right');
});

// ── Portfolio top ──
var ptop = document.querySelector('.portfolio-top');
if(ptop) assignReveal(ptop, 'reveal-drop');

// ── Contact section ──
var contactLeft = document.querySelector('.contact-grid > :first-child');
if(contactLeft && !contactLeft.closest('#hero')) assignReveal(contactLeft, 'reveal-left');
var contactRight = document.querySelector('.contact-grid > :last-child');
if(contactRight && !contactRight.closest('#hero')) assignReveal(contactRight, 'reveal-right');

// ── Marquee strip ──
var marquee = document.querySelector('.marquee-strip');
if(marquee) assignReveal(marquee, 'reveal-blur');

// ── Footer ──
document.querySelectorAll('footer > *').forEach(function(el, i){
  assignReveal(el, i % 2 === 0 ? 'reveal-left' : 'reveal-right');
  el.style.transitionDelay = (i * 0.1) + 's';
});

var revealEls = document.querySelectorAll(
  '.reveal,.reveal-left,.reveal-right,.reveal-blur,.reveal-scale,.reveal-flip,.reveal-drop,.reveal-spin'
);

// Per-element animation-delay base so stagger works with IntersectionObserver
var BASE_DELAY = 180;

var revealObserver = new IntersectionObserver(function(entries){
  entries.forEach(function(entry){
    var el = entry.target;
    if(entry.isIntersecting){
      var htmlDelay = parseFloat(el.style.transitionDelay) || 0;
      setTimeout(function(){
        el.classList.add('on');
      }, BASE_DELAY + htmlDelay * 1000);
    } else {
      if(entry.boundingClientRect.top > 0){
        el.classList.remove('on');
      }
    }
  });
}, {
  threshold: 0.08,
  rootMargin: '0px 0px -2% 0px'
});

revealEls.forEach(function(el){
  revealObserver.observe(el);
});

// Hero animates in immediately on load
setTimeout(function(){
  document.querySelectorAll(
    '#hero .reveal-left,#hero .reveal-right,#hero .reveal,#hero .reveal-blur,#hero .reveal-drop'
  ).forEach(function(el){
    el.classList.add('on');
  });
}, 300);


